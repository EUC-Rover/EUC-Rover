---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageUrl } from '../lib/site';
---
<BaseLayout lang="en" title="Page not found" alternate={pageUrl('lt')}>
  <div class="shell page-content" data-pagefind-ignore><p class="eyebrow">404</p><h1>Šio puslapio nėra / Page not found</h1><p>Grįžk į pradžią. / Return to the homepage.</p><div class="browse-links"><a class="button button--primary" href={pageUrl('lt')}>Pradžia — LT</a><a class="button button--outline" href={pageUrl('en')}>Home — EN</a></div></div>
</BaseLayout>
